{
  "name": "schrex-clearstory-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote (Streamable HTTP) read-only MCP connector for Clearstory on Cloudflare Workers (free plan), Schreiber Excavating",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings=ExperimentalWarning --import ./test/register.mjs --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
